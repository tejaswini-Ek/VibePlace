PORT=5000
NODE_ENV=development
JWT_SECRET=
# Local MongoDB example: mongodb://127.0.0.1:27017/mood-place
# Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mood-place
MONGODB_URI=mongodb://127.0.0.1:27017/mood-place
CLIENT_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
RESET_EMAIL_FROM=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OVERPASS_URL=https://overpass-api.de/api/interpreter
PHOTON_URL=https://photon.komoot.io/api/
